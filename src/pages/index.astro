---
import "../styles.css";
import { getSessionInfo, gridHourRange, listActivitiesWithSessions, listCourses, listPicksForOwner } from "../lib/db";
import { DAY_LABELS, formatMinutes } from "../lib/format";

// Stage 2a: the real 3-region shell, server-rendered from the seeded data —
// course list (left), week grid (main), session panel (right). Course
// selection is a plain `?course=` link so the whole page works with no JS.
// Stage 2b adds the Add/Remove write path and the no-JS clash dialog; the
// JS partial-update/preview layer is Stage 2c. See plan.md §4/§6.
const ownerId = Astro.locals.ownerId;

const courses = listCourses();
const requestedCourseId = Number(Astro.url.searchParams.get("course"));
const selectedCourse = courses.find((c) => c.id === requestedCourseId) ?? courses[0];
const activities = selectedCourse ? listActivitiesWithSessions(selectedCourse.id) : [];

const picks = listPicksForOwner(ownerId);
const pickedSessionByActivity = new Map(picks.map((p) => [p.activityId, p.sessionId]));

// The no-JS path for a rejected Add/swap (plan.md §6 step 6): /api/picks
// redirects back here with the two colliding session ids as query params.
const clashParam = Astro.url.searchParams.get("clash");
const withParam = Astro.url.searchParams.get("with");
const clashSession = clashParam ? getSessionInfo(Number(clashParam)) : undefined;
const clashWithSession = withParam ? getSessionInfo(Number(withParam)) : undefined;

const { startHour, endHour } = gridHourRange();
const halfHourSlots = (endHour - startHour) * 2;
const gridTemplateRows = `auto repeat(${halfHourSlots}, 1.75rem)`;

function rowForMinutes(minutes: number): number {
  return 2 + (minutes - startHour * 60) / 30;
}
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>A timetable I wish ANU had</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Timetable</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>A timetable I wish ANU had</h1>

      <div class="layout">
        <section class="course-list" aria-labelledby="courses-heading">
          <h2 id="courses-heading">Courses</h2>
          <ul>
            {
              courses.map((course) => (
                <li>
                  <a
                    href={`/?course=${course.id}`}
                    class="course-link"
                    aria-current={course.id === selectedCourse?.id ? "page" : undefined}
                  >
                    <span class="swatch" style={`background: ${course.color}`} aria-hidden="true" />
                    <span class="course-code">{course.code}</span>
                    <span class="course-title">{course.title}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="grid-wrap" aria-labelledby="grid-heading">
          <h2 id="grid-heading">Your timetable</h2>
          <div class="grid-scroll">
            <div class="grid" style={`grid-template-rows: ${gridTemplateRows}`}>
              {
                DAY_LABELS.map((day, dayIndex) => (
                  <div class="grid-day-header" style={`grid-column: ${dayIndex + 2}; grid-row: 1`}>
                    {day}
                  </div>
                ))
              }
              {
                Array.from({ length: endHour - startHour }).map((_, i) => (
                  <div class="grid-hour-label" style={`grid-column: 1; grid-row: ${2 + i * 2} / span 2`}>
                    {String(startHour + i).padStart(2, "0")}:00
                  </div>
                ))
              }
              {
                DAY_LABELS.map((_, dayIndex) =>
                  Array.from({ length: halfHourSlots }).map((_, slotIndex) => (
                    <div class="grid-cell" style={`grid-column: ${dayIndex + 2}; grid-row: ${2 + slotIndex}`} />
                  )),
                )
              }
              {
                picks.map((pick) => (
                  <a
                    class={`grid-pick${pick.sessionId === clashWithSession?.sessionId ? " clash" : ""}`}
                    href={`/?course=${pick.courseId}`}
                    style={`grid-column: ${pick.day + 2}; grid-row: ${rowForMinutes(pick.startMinutes)} / span ${
                      (pick.endMinutes - pick.startMinutes) / 30
                    }; background: ${pick.courseColor}`}
                  >
                    {pick.sessionId === clashWithSession?.sessionId && <span aria-hidden="true">⚠ </span>}
                    {pick.courseCode} · {pick.activityCode}
                  </a>
                ))
              }
            </div>
          </div>
        </section>

        <section class="session-panel" aria-labelledby="panel-heading">
          {
            selectedCourse ? (
              <>
                <h2 id="panel-heading">
                  {selectedCourse.code} — {selectedCourse.title}
                </h2>
                {activities.map((activity) => {
                  const pickedSessionId = pickedSessionByActivity.get(activity.id);
                  return (
                    <div class="activity">
                      <h3>
                        {activity.code}
                        {pickedSessionId !== undefined && (
                          <>
                            {" "}
                            <span aria-hidden="true">✓</span>
                            <span class="sr-only">picked</span>
                          </>
                        )}
                      </h3>
                      <ul class="session-list">
                        {activity.sessions.map((session) => (
                          <li class={session.id === pickedSessionId ? "picked" : undefined}>
                            <span>
                              {DAY_LABELS[session.day]} {formatMinutes(session.startMinutes)}–
                              {formatMinutes(session.endMinutes)} · {session.location}
                            </span>
                            {session.id === pickedSessionId ? (
                              <form method="POST" action="/api/picks/remove">
                                <input type="hidden" name="activityId" value={activity.id} />
                                <input type="hidden" name="courseId" value={selectedCourse.id} />
                                <button type="submit">Remove</button>
                              </form>
                            ) : (
                              <form method="POST" action="/api/picks">
                                <input type="hidden" name="sessionId" value={session.id} />
                                <input type="hidden" name="courseId" value={selectedCourse.id} />
                                <button type="submit">Add</button>
                              </form>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  );
                })}
              </>
            ) : (
              <p>No courses yet.</p>
            )
          }
        </section>
      </div>

      {
        clashSession && clashWithSession && (
          <dialog open aria-labelledby="clash-heading">
            <h2 id="clash-heading">That clashes with a session you already picked</h2>
            <p>
              <strong>
                {clashSession.courseCode} {clashSession.activityCode}
              </strong>{" "}
              ({DAY_LABELS[clashSession.day]} {formatMinutes(clashSession.startMinutes)}–
              {formatMinutes(clashSession.endMinutes)}) overlaps{" "}
              <strong>
                {clashWithSession.courseCode} {clashWithSession.activityCode}
              </strong>{" "}
              ({DAY_LABELS[clashWithSession.day]} {formatMinutes(clashWithSession.startMinutes)}–
              {formatMinutes(clashWithSession.endMinutes)}), which is already on your timetable. Remove it first if
              you want to make this swap.
            </p>
            <form method="dialog">
              <button type="submit">OK</button>
            </form>
          </dialog>
        )
      }
    </main>
  </body>
</html>
